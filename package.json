{
  "name": "ledn-token-security-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ledn Token — Security Engineering take-home challenge (intentionally vulnerable sandbox)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "reviewer:attack": "tsx reviewer/attack.ts",
    "reviewer:regression": "vitest run reviewer/security-regression.spec.ts",
    "reviewer:detections": "tsx evidence/replay-detections.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
